# rename to .github/workflows/test.yml once the repo has the workflow scope enabled.
name: tests

on:
  push:
    branches: [main]
  pull_request:

jobs:
  test:
    runs-on: ubuntu-20.04
    steps:
      - uses: actions/checkout@v3
      - uses: actions/setup-python@v3
        with:
          python-version: "3.9"
      - name: install
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
      - name: pytest
        run: pytest -q

  compile:
    runs-on: ubuntu-20.04
    needs: test
    steps:
      - uses: actions/checkout@v3
      - uses: actions/setup-python@v3
        with:
          python-version: "3.9"
      - run: |
          pip install -r requirements.txt
          python pipelines/compile.py --out dist/demand_forecast.json
      - uses: actions/upload-artifact@v3
        with:
          name: pipeline-spec
          path: dist/demand_forecast.json
